<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <NoWarn>$(NoWarn);NU1507</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="ConsoleAppFramework" Version="5.8.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.14" />
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="8.0.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.13" />
    <PackageVersion Include="Nogic.ThrowHelperExtensions" Version="2.0.0" />
    <PackageVersion Include="PolySharp" Version="1.17.1" />
    <PackageVersion Include="Portable.System.DateTimeOnly" Version="9.0.2" />
    <PackageVersion Include="Portable.System.DateTimeOnly.Json" Version="9.1.1" />
    <PackageVersion Include="RandomFixtureKit" Version="1.0.1" />
    <PackageVersion Include="System.Net.Http.Json" Version="10.0.13" />
    <PackageVersion Include="System.Text.Json" Version="10.0.13" />
    <PackageVersion Include="TUnit" Version="1.81.16" />
    <PackageVersion Include="TUnit.Mocks" Version="1.81.16" />
    <PackageVersion Include="TUnit.Mocks.Http" Version="1.81.16" />
  </ItemGroup>
</Project>
